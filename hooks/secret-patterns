# Extended regexes (grep -E), one per line, matched against the lines a commit
# ADDS. Lines starting with # and empty lines are skipped. Keep them tight:
# a pattern that fires on ordinary source gets the whole hook bypassed.

# PEM private keys (RSA, EC, OPENSSH, PGP, plain PKCS#8)
-----BEGIN [A-Z ]*PRIVATE KEY( BLOCK)?-----

# Anthropic API keys
(^|[^A-Za-z0-9_-])sk-ant-[A-Za-z0-9_-]{32,}

# OpenAI-style keys: classic 48-char ones and the prefixed project/service ones
(^|[^A-Za-z0-9_-])sk-[A-Za-z0-9]{40,}
(^|[^A-Za-z0-9_-])sk-(proj|svcacct|admin)-[A-Za-z0-9_-]{40,}

# GitHub tokens
(^|[^A-Za-z0-9_])gh[pousr]_[A-Za-z0-9]{36,}
(^|[^A-Za-z0-9_])github_pat_[A-Za-z0-9_]{60,}

# AWS access key ids
(^|[^A-Z0-9])AKIA[0-9A-Z]{16}([^A-Z0-9]|$)
